# LLM API & Model Configuration
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b




# Search & Weather APIs (Used by FastMCP Server)
TAVILY_API_KEY=your_tavily_api_key
OPENWEATHER_API_KEY=your_openweathermap_api_key

# Self-Hosted Native PostgreSQL (Standard port 5432)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/travel_planner

# Qdrant Vector Storage (Default: embedded storage at ./qdrant_data)
# Optional: Set QDRANT_USE_REMOTE=true if running standalone Qdrant server
QDRANT_HOST=localhost
QDRANT_PORT=6333 